{
  "name": "json-config-editor",
  "displayName": "JSON Config Editor",
  "description": "Tree-view editor for large nested JSON configs",
  "version": "0.0.1",
  "publisher": "jesgum",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jesgum/json-config-editor"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:jsonConfigEditor.toggleOn",
    "onCommand:jsonConfigEditor.toggleOff",
    "onCustomEditor:jsonConfigEditor.visual"
  ],
  "contributes": {
    "commands": [
      {
        "command": "jsonConfigEditor.toggleOn",
        "title": "Toggle JSON Config Editor ON",
        "category": "JSON Config Editor"
      },
      {
        "command": "jsonConfigEditor.toggleOff",
        "title": "Toggle JSON Config Editor OFF",
        "category": "JSON Config Editor"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "(resourceLangId == json || resourceLangId == jsonc || activeCustomEditorId == jsonConfigEditor.visual) && !jsonConfigEditor.isActive",
          "command": "jsonConfigEditor.toggleOn",
          "group": "navigation"
        },
        {
          "when": "(resourceLangId == json || resourceLangId == jsonc || activeCustomEditorId == jsonConfigEditor.visual) && jsonConfigEditor.isActive",
          "command": "jsonConfigEditor.toggleOff",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "jsonConfigEditor.visual",
        "displayName": "Config Editor (Visual)",
        "selector": [
          {
            "filenamePattern": "*.json"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "dev": "npm run compile && vsce package && code --install-extension json-config-editor-*.vsix --force"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.1.0"
  }
}